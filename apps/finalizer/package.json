{
  "name": "@moss/phase2-finalizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "moss-phase2-finalize": "./dist/cli.js",
    "moss-phase2-audit": "./dist/audit/cli.js",
    "moss-phase2-publish": "./dist/publish/cli.js",
    "moss-phase2-proof-test": "./dist/proof-test/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "audit": "node dist/audit/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@moss/phase2-protocol": "workspace:*",
    "@moss/phase2-zkey-inspect": "workspace:*",
    "drand-client": "1.4.2",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/snarkjs": "0.7.9",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
