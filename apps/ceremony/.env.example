KV_REST_API_URL=
KV_REST_API_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

COORDINATOR_BASE_URL=http://127.0.0.1:58787
CEREMONY_SLUG=moss-phase2-local-development
MANIFEST_ROOT_KEY_ID=manifest-root-dev
MANIFEST_ROOT_PUBLIC_KEY_FILE=
MANIFEST_ROOT_PUBLIC_KEY_SPKI_SHA256=

PARTICIPANT_JWT_PRIVATE_KEY_FILE=
PARTICIPANT_JWT_ISSUER=moss-phase2-local-web
PARTICIPANT_JWT_AUDIENCE=moss-phase2-local-coordinator
PARTICIPANT_ID_DERIVATION_KEY_FILE=

# Keep false until the production-size zkey passes the documented browser
# benchmark matrix for this exact web release.
NEXT_PUBLIC_BROWSER_CONTRIBUTIONS_ENABLED=false

# Optional post-contribution NFT claim service. Disabled until the contract is deployed.
# These are server-only settings; use a dedicated signer, never a ceremony key.
NFT_CLAIMS_ENABLED=false
NFT_NETWORK=testnet
NFT_CONTRACT_ADDRESS=
NFT_RPC_URL=
# Configure exactly one of the inline secret (Vercel) or private file (local).
# NFT_CLAIM_SIGNER_PRIVATE_KEY_FILE=/absolute/path/to/private-nft-signer.key
# NFT_CLAIM_SIGNER_PRIVATE_KEY= (set only in the deployment secret manager)
