{
  "name": "moss-phase2-ceremony",
  "description": "Public Groth16 Phase 2 ceremony for the MOSS Google zkLogin relation",
  "private": true,
  "scripts": {
    "format": "pnpm -r --if-present format",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r test && pnpm test:infra",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "dev:web": "pnpm --filter @moss/phase2-ceremony-web dev",
    "dev:artifacts": "node infra/docker/prepare-dev-artifacts.mjs",
    "dev:stack": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "clean": "pnpm -r clean",
    "sign:manifest": "node infra/sign-manifest.mjs",
    "build:manifest": "node infra/build-manifest.mjs",
    "circuit:closure": "node infra/circuit-closure.mjs",
    "web:release": "node infra/web-release.mjs",
    "test:infra": "node --test infra/docker/runtime-entry.test.mjs infra/manifest-tools.test.mjs infra/aws/rehearsal.test.mjs infra/operational-update.test.mjs infra/finalization-record.test.mjs infra/generate-secrets.test.mjs",
    "test:contracts": "pnpm --filter @moss/contribution-nft test:contracts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "minimatch@>=5.0.0 <5.1.8": "5.1.9",
      "brace-expansion": "5.0.9",
      "jsonpath@<=1.2.1": "1.3.0",
      "underscore@<=1.13.7": "1.13.8",
      "rollup@>=4.0.0 <4.59.0": "4.60.1",
      "postcss": "8.5.25",
      "undici@<6.27.0": "6.27.0",
      "sharp": "0.35.4",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "fast-uri@>=4.0.0 <4.1.3": "4.1.3",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
